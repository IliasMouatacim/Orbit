<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>orbit.ico</ApplicationIcon>
    <AssemblyName>OrbitChat</AssemblyName>
    <Version>1.1.0</Version>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SIPSorcery" Version="10.0.17" />
    <PackageReference Include="SIPSorcery.VP8" Version="10.0.17" />
    <PackageReference Include="SIPSorceryMedia.Windows" Version="10.0.17" />
    <PackageReference Include="libsodium" Version="1.0.22" />
  </ItemGroup>
</Project>
